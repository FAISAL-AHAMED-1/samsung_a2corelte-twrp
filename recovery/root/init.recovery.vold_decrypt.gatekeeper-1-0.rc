service sys_gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user system
    group system
    setenv PATH /vendor/bin:/system/bin:/system/vendor/bin
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/vendor/lib
    disabled
    oneshot
    seclabel u:r:hal_gatekeeper_default:s0
